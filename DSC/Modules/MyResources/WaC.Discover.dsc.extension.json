{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "WaC/Discover",
  "version": "0.1.0",
  "description": "Discovers DSC resources from WaC.",
  "discover": {
    "executable": "powershell",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-NoProfile",
      "-Command",
      "./WaC.Discover.ps1"
    ]
  }
}
