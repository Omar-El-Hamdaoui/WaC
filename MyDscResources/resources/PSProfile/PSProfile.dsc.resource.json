{
  "$schema": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3/resource/manifest.json",
  "type": "MyCompany.Packages/ChocolateyPackage",
  "version": "1.0.0",
  "description": "Manages individual Chocolatey packages installation",
  "get": {
    "executable": "pwsh",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-File",
      "./ChocolateyPackage.ps1",
      "Get"
    ],
    "input": "stdin"
  },
  "set": {
    "executable": "pwsh",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-File",
      "./ChocolateyPackage.ps1",
      "Set"
    ],
    "input": "stdin",
    "implementsPretest": true,
    "return": "state"
  },
  "test": {
    "executable": "pwsh",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-File",
      "./ChocolateyPackage.ps1",
      "Test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "schema": {
    "embedded": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "packageName": {
          "type": "string",
          "description": "Name of the Chocolatey package"
        },
        "version": {
          "type": "string",
          "description": "Version of the package to install",
          "default": "latest"
        },
        "ensure": {
          "type": "string",
          "enum": ["Present", "Absent"],
          "description": "Whether the package should be installed or removed",
          "default": "Present"
        }
      },
      "required": ["packageName"]
    }
  }
}